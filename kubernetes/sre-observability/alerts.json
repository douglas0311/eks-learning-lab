{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PrometheusRule",
  "metadata": {
    "name": "sre-simple-test",
    "namespace": "monitoring",
    "labels": {
      "release": "kube-prometheus-stack"
    }
  },
  "spec": {
    "groups": [
      {
        "name": "sre-simple-test",
        "rules": [
          {
            "alert": "SRELabRolloutStalled",
            "expr": "kube_deployment_status_condition{namespace=\"simple-test\",deployment=\"simple-test\",condition=\"Progressing\",status=\"false\"} == 1",
            "for": "1m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "simple-test rollout is not progressing"
            }
          },
          {
            "alert": "SRELabPodPending",
            "expr": "kube_pod_status_phase{namespace=\"simple-test\",phase=\"Pending\"} == 1",
            "for": "2m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "A simple-test Pod remains Pending"
            }
          },
          {
            "alert": "SRELabContainerRestarting",
            "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"simple-test\",container=\"simple-test\"}[10m]) > 2",
            "for": "1m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "A simple-test container is restarting repeatedly"
            }
          },
          {
            "alert": "SRELabNodeSchedulingDisabled",
            "expr": "kube_node_spec_unschedulable == 1",
            "for": "2m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "A node is unavailable for normal scheduling"
            }
          },
          {
            "alert": "SRELabNodeNotReady",
            "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0",
            "for": "2m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "A node is not Ready"
            }
          },
          {
            "alert": "SRELabNodePressure",
            "expr": "kube_node_status_condition{condition=~\"MemoryPressure|DiskPressure|PIDPressure\",status=\"true\"} == 1",
            "for": "2m",
            "labels": {
              "severity": "warning",
              "scope": "sre-lab"
            },
            "annotations": {
              "summary": "A node reports resource pressure"
            }
          }
        ]
      }
    ]
  }
}
