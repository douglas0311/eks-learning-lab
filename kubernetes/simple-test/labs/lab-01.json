{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "simple-test",
            "args": [
              "-c",
              "/etc/nginx/lab.conf",
              "-g",
              "daemon off;"
            ],
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            }
          }
        ]
      }
    }
  }
}
